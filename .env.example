# ==========================================
# RouteIQ — Environment Configuration
# ==========================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Persistence (PostgreSQL / Supabase)
# For local development with SQLite fallback: sqlite:///./routeiq.db
# For Supabase / Render production PostgreSQL:
DATABASE_URL=sqlite:///./routeiq.db

# Candidate Identity (Lowercase, byte-identical everywhere)
CANDIDATE_ID=priya.sharma@gmail.com

# Server & Network Configuration
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0
